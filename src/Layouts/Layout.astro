---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<!DOCTYPE html>
<html lang="en">

<!-- Head -->
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO Meta Tags -->
  <title>Zohaib | Frontend Developer</title>
  <meta name="description"
    content="Frontend Developer building modern, scalable web applications from idea to deployment." />
  <meta name="author" content="Zohaib Ali" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#000000" />
  <link rel="canonical" href="https://iamzohaib.me/" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+JP:wght@300;500;700&display=swap"
    rel="stylesheet">


  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script is:inline >

    (function () {
      var theme = 'dark';
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') theme = saved;
      } catch (e) { /* storage blocked: stay on dark */ }
      document.documentElement.setAttribute('data-theme', theme);
    })();

  </script>

  <!-- If JavaScript is disabled, show all sections instead of leaving them invisible -->
  <noscript>
    <style>
        
      .reveal {
        opacity: 1 !important;
        transform: none !important;
      }

      .preloader {
        display: none !important;
      }

      .hero .word,
      .hero-buttons {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }

    </style>
  </noscript>

  <!-- Structured data for Google -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Zohaib Ali",
    "url": "https://iamzohaib.me/",
    "jobTitle": "Frontend Developer",
    "description": "Frontend Developer building modern, scalable web applications from idea to deployment.",
    "sameAs": [
      "https://github.com/hezohaib",
      "https://www.linkedin.com/in/zohaib-ali-095716406/"
    ]
  }
  </script>
</head>

<!-- Body -->
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  <div id="preloader" class="preloader" aria-hidden="true">
    <svg class="pl-z" viewBox="0 0 32 32">
      <path pathLength="100" d="M9 10 H23 L9 22 H23" />
      <rect class="pl-dot" x="24.5" y="20.5" width="3.5" height="3.5" />
    </svg>
  </div>

 <!-- Header -->
 <Header/>

 <!-- Main -->
 <main id="main">
    <slot />
 </main>

 <!-- Glassmorphism Smooth Contact Modal -->
 <ContactModal/>
  
 <!--Footer -->
  <Footer />

  <!-- Main JavaScript File -->
  <script>
  import Lenis from 'lenis';
  (window as any).Lenis = Lenis;
  import '../scripts/main.js';
</script>

</body>

</html>